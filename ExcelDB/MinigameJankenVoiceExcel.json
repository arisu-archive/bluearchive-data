    {
      "id": 86000409,
      "character_id": 860004,
      "costume_unique_id": 1900957101,
      "event_content_id": 860,
      "voice_condition": 4,
      "animation_name": "02",
      "duration": 3080,
      "localize_kr": "후훗, 정보력의\n차이라는 거네.",
      "localize_jp": "ふふっ、これが\n情報の差よ。",
      "localize_th": "ฮุฮุ ข้อมูลที่มี\nมันต่างกันนี่นะ",
      "localize_tw": "呵呵，這就是\n情報的差距哦。",
      "localize_en": "Fufu. A difference of intel.",
      "voice_id": 1692199428
    },
    {
      "id": 86000410,
      "character_id": 860004,
      "costume_unique_id": 1900957101,
      "event_content_id": 860,
      "voice_condition": 4,
      "animation_name": "01",
      "duration": 1100,
      "localize_kr": "제법이잖아?",
