    {
      "id": 86000109,
      "character_id": 860001,
      "costume_unique_id": 1900957001,
      "event_content_id": 860,
      "voice_condition": 4,
      "animation_name": "13",
      "duration": 3120,
      "localize_kr": "너는 게헨나\n워리어다!",
      "localize_jp": "お前はゲヘナの\nウォーリアーだ！",
      "localize_th": "เจ้าคือนักรบ\nแห่งเกเฮนน่า!",
      "localize_tw": "你是格黑娜\n的戰士！",
      "localize_en": "You are Gehenna's warrior!",
      "voice_id": 3078117574
    },
    {
      "id": 86000110,
      "character_id": 860001,
      "costume_unique_id": 1900957001,
      "event_content_id": 860,
      "voice_condition": 4,
      "animation_name": "15",
      "duration": 2270,
      "localize_kr": "요깃거리도\n안 되는군!",
      "localize_jp": "腹の足しにも\nならんな！",
      "localize_th": "เรียกว่าลูกกระจ๊อก\nไม่ได้ด้วยซ้ำ!",
      "localize_tw": "連塞牙縫\n都不夠！",
      "localize_en": "Barely even small fry!",
      "voice_id": 2859250222
    },
    {
      "id": 86000111,
      "character_id": 860001,
      "costume_unique_id": 1900957001,
      "event_content_id": 860,
      "voice_condition": 5,
      "animation_name": "07",
      "duration": 3550,
      "localize_kr": "소라사키\n히나-!!",
      "localize_jp": "空崎\nヒナァーー！！",
      "localize_th": "โซระซากิ ฮินะ!!!",
      "localize_tw": "空崎\n陽奈──！！",
      "localize_en": "Sorasaki Hina!!!",
