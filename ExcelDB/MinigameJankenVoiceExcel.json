      "costume_unique_id": 1900957301,
      "event_content_id": 860,
      "voice_condition": 4,
      "animation_name": "07",
      "duration": 1920,
      "localize_kr": "나쁜 아이를 꼬\n집어 주는 거야!",
      "localize_jp": "意地悪は、メッ！",
      "localize_th": "หนีบพวกนิสัยไม่ดี\nให้หมดเลย!",
      "localize_tw": "不可以壞壞！",
      "localize_en": "Pinch the bad guys!",
      "voice_id": 358319106
    },
    {
      "id": 86000310,
      "character_id": 860003,
      "costume_unique_id": 1900957301,
      "event_content_id": 860,
      "voice_condition": 4,
      "animation_name": "09",
      "duration": 3080,
      "localize_kr": "꼬집이 씨,\n대단해!",
      "localize_jp": "カニカニさん、\nすごーい！",
      "localize_th": "คุณก้ามหนีบ\nสุดยอดไปเลย!",
      "localize_tw": "夾夾先生，\n好厲害～！",
      "localize_en": "Mr. Pinchy, you're incredible!",
      "voice_id": 3407517078
    },
    {
      "id": 86000311,
      "character_id": 860003,
      "costume_unique_id": 1900957301,
      "event_content_id": 860,
      "voice_condition": 5,
      "animation_name": "04",
      "duration": 3320,
      "localize_kr": "아픈 거, 아픈 거\n날아가라!",
      "localize_jp": "痛いの、痛いの、\nとんでけー！",
      "localize_th": "ความเจ็บเอ๋ย จงหายไป!",
      "localize_tw": "痛痛，痛痛，\n飛走吧～！",
      "localize_en": "Pain, pain, go away!",
      "voice_id": 2336583358
    },
