    {
      "id": 86000209,
      "character_id": 860002,
      "costume_unique_id": 1900957201,
      "event_content_id": 860,
      "voice_condition": 4,
      "animation_name": "13",
      "duration": 3160,
      "localize_kr": "후후,\n이 정도려나요?",
      "localize_jp": "ふふっ。こんな\nものでしょうか。",
      "localize_th": "ฮุฮุ แค่นี้พอรึเปล่าคะ?",
      "localize_tw": "呵呵，差不多\n就是這樣吧。",
      "localize_en": "Fufu. That good enough?",
      "voice_id": 4159284354
    },
    {
      "id": 86000210,
      "character_id": 860002,
      "costume_unique_id": 1900957201,
      "event_content_id": 860,
      "voice_condition": 4,
      "animation_name": "01",
      "duration": 1390,
      "localize_kr": "적당히\n밥값은 하죠.",
      "localize_jp": "良い働きです。",
      "localize_th": "คงต้องตั้งใจ\nสักหน่อยแล้วค่ะ",
      "localize_tw": "表現得不錯。",
      "localize_en": "I guess I'll do my part.",
      "voice_id": 1948256948
    },
    {
      "id": 86000211,
      "character_id": 860002,
      "costume_unique_id": 1900957201,
      "event_content_id": 860,
      "voice_condition": 5,
      "animation_name": "04",
      "duration": 1750,
      "localize_kr": "제가 이런\n실수를…!",
      "localize_jp": "私がこんな\nミスを……！",
      "localize_th": "ฉันพลาดไป\nซะแล้ว...!",
      "localize_tw": "我竟然會犯\n這種錯誤……！",
      "localize_en": "I messed up...!",
      "voice_id": 714642512
    },
